# Server Configuration (Render)
PORT=5000
NODE_ENV=production

# Render -> Vercel Cross-Origin Setting
# Set this to your Vercel deployment URL (e.g. https://your-project.vercel.app)
# Multiple origins can be comma-separated: https://your-project.vercel.app,http://localhost:3000
CLIENT_ORIGIN=https://your-frontend.vercel.app

# PostgreSQL Connection (Cloud Neon / Supabase / standard PostgreSQL)
DATABASE_URL="postgresql://neondb_owner:password@ep-placeholder.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Authentication Security (Use a long random string of at least 32 characters)
JWT_SECRET=super_secure_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Privilege escalation protection for privileged roles (ADMIN, PROCUREMENT_OFFICER, MANAGER_APPROVER)
ADMIN_INVITE_CODE=ADMIN_SECURE_SETUP_2025
