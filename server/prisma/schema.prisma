datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --- Week 1 Enums ---

enum Role {
  ADMIN
  PROCUREMENT_OFFICER
  MANAGER_APPROVER
  VENDOR
}

enum VendorStatus {
  ACTIVE
  PENDING
  BLOCKED
}

enum POStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  ISSUED
  CANCELLED
}

// --- Week 2 Enums ---

enum RfqStatus {
  DRAFT
  OPEN
  CLOSED
  AWARDED
  CANCELLED
}

enum InvitationStatus {
  INVITED
  VIEWED
  QUOTED
  DECLINED
}

enum QuotationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  SELECTED
  APPROVED
  REJECTED
}

// --- Week 3 Enums ---

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InvoiceStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
}

// --- Models ---

model SystemSequence {
  name         String   @id // e.g. "RFQ_2026", "QT_2026", "PO_2026", "INV_2026"
  currentValue Int      @default(0)
  updatedAt    DateTime @updatedAt
}

model User {
  id             String               @id @default(uuid())
  firstName      String
  lastName       String
  email          String               @unique
  passwordHash   String
  phoneNumber    String?
  role           Role                 @default(VENDOR)
  country        String?              @default("India")
  additionalInfo String?
  avatarUrl      String?
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  passwordResets     PasswordResetToken[]
  vendorProfile      Vendor?              @relation("VendorUser")
  createdVendors     Vendor[]             @relation("VendorCreator")
  rfqsCreated        Rfq[]                @relation("RfqCreator")
  approvalsSubmitted ApprovalRequest[]    @relation("ApprovalSubmitter")
  approvalsDecided   ApprovalRequest[]    @relation("ApprovalDecider")
  approvalActions    ApprovalHistory[]    @relation("ApprovalActionUser")
  purchaseOrdersAuth PurchaseOrder[]      @relation("POCreator")
  invoicesCreated    Invoice[]            @relation("InvoiceCreator")
  auditLogs          AuditLog[]
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Vendor {
  id             String                @id @default(uuid())
  name           String
  category       String                // Constructions, IT, Logistics, Manufacturing, Services, Furniture
  gstin          String                @unique // 15-char Indian GSTIN
  contactPerson  String
  email          String
  phone          String
  address        String
  city           String?
  state          String?
  pincode        String?
  country        String                @default("India")
  status         VendorStatus          @default(PENDING)
  notes          String?

  createdById    String?
  createdBy      User?                 @relation("VendorCreator", fields: [createdById], references: [id])
  userId         String?               @unique
  user           User?                 @relation("VendorUser", fields: [userId], references: [id])

  purchaseOrders PurchaseOrder[]
  invoices       Invoice[]
  rfqInvitations RfqVendorInvitation[]
  quotations     Quotation[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([name])
  @@index([gstin])
  @@index([category])
  @@index([status])
}

model PurchaseOrder {
  id             String              @id @default(uuid())
  poNumber       String              @unique // Formatted: PO-YYYY-XXXX
  vendorId       String
  vendor         Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  amount         Float               // Week 1 legacy compatibility
  subtotalAmount Decimal?            @db.Decimal(12, 2)
  taxAmount      Decimal?            @db.Decimal(12, 2)
  grandTotal     Decimal?            @db.Decimal(12, 2)
  status         POStatus            @default(PENDING)
  orderDate      DateTime            @default(now())

  rfqId          String?
  rfq            Rfq?                @relation(fields: [rfqId], references: [id], onDelete: SetNull)
  quotationId    String?             @unique
  quotation      Quotation?          @relation(fields: [quotationId], references: [id], onDelete: SetNull)

  paymentTerms   String?
  deliveryDays   Int?
  notes          String?

  createdById    String?
  createdBy      User?               @relation("POCreator", fields: [createdById], references: [id], onDelete: SetNull)

  items          PurchaseOrderItem[]
  invoice        Invoice?

  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([vendorId])
  @@index([status])
  @@index([rfqId])
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  itemDescription String
  quantity        Decimal       @db.Decimal(10, 2)
  uom             String        // NOS, Units, KG, Meters, Licenses
  unitPrice       Decimal       @db.Decimal(12, 2)
  lineTotal       Decimal       @db.Decimal(12, 2)
  createdAt       DateTime      @default(now())

  @@index([purchaseOrderId])
}

model Invoice {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique // Formatted: INV-YYYY-XXXX
  purchaseOrderId String        @unique
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  vendorId        String
  vendor          Vendor        @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  subtotalAmount  Decimal       @db.Decimal(12, 2)
  taxRate         Decimal       @default(18.00) @db.Decimal(5, 2)
  taxAmount       Decimal       @db.Decimal(12, 2)
  taxBreakdown    Json?         // e.g. {"type": "CGST_SGST", "cgstRate": 9, "cgstAmount": 19800, "sgstRate": 9, "sgstAmount": 19800}
  grandTotal      Decimal       @db.Decimal(12, 2)

  status          InvoiceStatus @default(PENDING_PAYMENT)
  dueDate         DateTime?
  paidAt          DateTime?
  notes           String?

  createdById     String?
  createdBy       User?         @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: SetNull)

  items           InvoiceItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([vendorId])
  @@index([status])
  @@index([purchaseOrderId])
}

model InvoiceItem {
  id              String   @id @default(uuid())
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemDescription String
  quantity        Decimal  @db.Decimal(10, 2)
  uom             String
  unitPrice       Decimal  @db.Decimal(12, 2)
  lineTotal       Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  @@index([invoiceId])
}

model ApprovalRequest {
  id            String            @id @default(uuid())
  rfqId         String
  rfq           Rfq               @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  quotationId   String            @unique
  quotation     Quotation         @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  status        ApprovalStatus    @default(PENDING)

  submittedById String
  submittedBy   User              @relation("ApprovalSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  decidedById   String?
  decidedBy     User?             @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  decidedAt     DateTime?
  remarks       String?

  history       ApprovalHistory[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([rfqId])
  @@index([status])
  @@index([submittedById])
  @@index([decidedById])
}

model ApprovalHistory {
  id                String          @id @default(uuid())
  approvalRequestId String
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  action            String          // SUBMITTED, APPROVED, REJECTED
  actorId           String
  actor             User            @relation("ApprovalActionUser", fields: [actorId], references: [id], onDelete: Restrict)
  remarks           String?
  createdAt         DateTime        @default(now())

  @@index([approvalRequestId])
  @@index([actorId])
}

model Rfq {
  id                  String                @id @default(uuid())
  rfqNumber           String                @unique // Formatted: RFQ-YYYY-XXXX
  title               String
  description         String
  category            String                // Furniture, IT Hardware, Logistics, Constructions, Services
  deliveryLocation    String                @default("Central Warehouse, Mumbai")
  deadline            DateTime
  status              RfqStatus             @default(OPEN)

  createdById         String
  createdBy           User                  @relation("RfqCreator", fields: [createdById], references: [id], onDelete: Restrict)

  // Single Selected Quotation Guarantee: exactly one quotation can be selected for an RFQ
  selectedQuotationId String?               @unique
  selectedQuotation   Quotation?            @relation("SelectedQuotation", fields: [selectedQuotationId], references: [id], onDelete: SetNull)

  items               RfqItem[]
  invitations         RfqVendorInvitation[]
  quotations          Quotation[]           @relation("RfqQuotations")
  attachments         RfqAttachment[]
  approvalRequests    ApprovalRequest[]
  purchaseOrders      PurchaseOrder[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([category])
  @@index([status])
  @@index([deadline])
}

model RfqItem {
  id              String          @id @default(uuid())
  rfqId           String
  rfq             Rfq             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  itemDescription String
  quantity        Decimal         @db.Decimal(10, 2)
  uom             String          // NOS, Units, KG, Meters, Licenses
  targetPrice     Decimal?        @db.Decimal(12, 2)
  createdAt       DateTime        @default(now())

  quotationItems  QuotationItem[]

  @@index([rfqId])
}

model RfqVendorInvitation {
  id          String           @id @default(uuid())
  rfqId       String
  rfq         Rfq              @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendorId    String
  vendor      Vendor           @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  status      InvitationStatus @default(INVITED)
  invitedAt   DateTime         @default(now())
  respondedAt DateTime?

  @@unique([rfqId, vendorId])
  @@index([vendorId])
}

model Quotation {
  id              String          @id @default(uuid())
  quotationNumber String          @unique // Formatted: QT-YYYY-XXXX
  rfqId           String
  rfq             Rfq             @relation("RfqQuotations", fields: [rfqId], references: [id], onDelete: Restrict)
  vendorId        String
  vendor          Vendor          @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  // High-precision financial totals (calculated authoritatively on backend)
  subtotalAmount  Decimal         @db.Decimal(12, 2)
  taxRate         Decimal         @default(18.00) @db.Decimal(5, 2) // Standard GST %
  taxAmount       Decimal         @db.Decimal(12, 2)
  grandTotal      Decimal         @db.Decimal(12, 2)

  deliveryDays    Int             // Delivery turnaround in calendar days
  paymentTerms    String          // e.g. "30 days net", "15 days net"
  validityDate    DateTime
  notes           String?
  status          QuotationStatus @default(SUBMITTED)

  selectedForRfq  Rfq?            @relation("SelectedQuotation")
  approvalRequest ApprovalRequest?
  purchaseOrder   PurchaseOrder?

  items           QuotationItem[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([rfqId, vendorId]) // Strictly one active quotation per vendor per RFQ
  @@index([rfqId])
  @@index([vendorId])
  @@index([grandTotal])
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  rfqItemId   String
  rfqItem     RfqItem   @relation(fields: [rfqItemId], references: [id], onDelete: Restrict)

  unitPrice   Decimal   @db.Decimal(12, 2)
  lineTotal   Decimal   @db.Decimal(12, 2) // quantity * unitPrice
  remarks     String?

  @@unique([quotationId, rfqItemId]) // Exactly one quote line per RFQ item
  @@index([quotationId])
  @@index([rfqItemId])
}

model RfqAttachment {
  id        String   @id @default(uuid())
  rfqId     String
  rfq       Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  fileName  String   // Original filename
  fileSize  Int      // In bytes (max 5MB enforced)
  mimeType  String   // e.g. application/pdf, image/png
  fileData  Bytes    // Binary content stored securely in Neon PostgreSQL
  createdAt DateTime @default(now())

  @@index([rfqId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String?
  createdAt DateTime @default(now())
}
