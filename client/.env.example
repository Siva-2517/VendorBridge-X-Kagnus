# VendorBridge Frontend Environment Configuration (Vercel)
# In production on Vercel: Set VITE_API_URL to your Render backend URL (e.g. https://vendorbridge-api.onrender.com)
# In local development: Set to http://localhost:5000 or leave blank to use the Vite proxy
VITE_API_URL=https://your-backend-api.onrender.com
