# Render Server Configuration
PORT=5000
NODE_ENV=production
CLIENT_ORIGIN=https://your-frontend.vercel.app

# PostgreSQL Connection (Cloud Neon / Supabase / standard PostgreSQL)
DATABASE_URL="postgresql://neondb_owner:password@ep-placeholder.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Authentication Security
JWT_SECRET=super_secure_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Privilege escalation protection: privileged roles (ADMIN, PROCUREMENT_OFFICER, MANAGER_APPROVER) require this invite code
ADMIN_INVITE_CODE=ADMIN_SECURE_SETUP_2025

# Vercel Frontend Configuration (client/.env)
# Set VITE_API_URL to your Render web service backend URL
VITE_API_URL=https://your-backend-api.onrender.com

